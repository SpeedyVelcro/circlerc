; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="CircleRC"
run/main_scene="res://UI/MainMenu/MainMenu.tscn"
config/features=PackedStringArray("4.7")
boot_splash/bg_color=Color(0.129412, 0.129412, 0.129412, 1)
boot_splash/image="res://Art/CircleRC/Godot/LoadingSplash.png"
config/icon="res://Art/CircleRC/Godot/icon.png"
config/windows_native_icon="res://Art/CircleRC/Godot/icon.ico"

[autoload]

SceneTransition="*res://AutoLoad/SceneTransition.gd"
Profile="*res://AutoLoad/Profile.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="2d"

